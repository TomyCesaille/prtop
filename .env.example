# prtop settings. Copy this file to ~/.config/prtop/.env (%APPDATA%\prtop\.env on
# Windows) and uncomment what you need: a setting left out keeps the default shown.
# A variable of the same name in the environment wins over this file.

# The GitLab instance to read, as `glab auth login --hostname` knows it.
# PRTOP_GITLAB_HOST=gitlab.com

# Only list merge requests in this group and its subgroups.
# PRTOP_GITLAB_GROUP=

# Your username on the instance, to tell your own threads from a reviewer's.
# Read from the instance when unset.
# PRTOP_GITLAB_USERNAME=

# Where the Task column comes from: none, issues, notion, jira or branch.
# PRTOP_TASK_SOURCE=none

# With PRTOP_TASK_SOURCE=branch: a regular expression searched in the branch name.
# A `task` group is the label; without one, the `id` group followed by the `title`
# group. Every group is available to PRTOP_TASK_URL.
# PRTOP_TASK_BRANCH_PATTERN=(?P<id>\d+)-(?P<title>[^/]+)$

# The task link, built from the pattern's groups.
# PRTOP_TASK_URL=https://tracker.example.com/tasks/{id}

# Follow merged merge requests to production.
# PRTOP_DEPLOY_TRACKING=on

# Jobs that deploy to production, and among them the one whose success means the
# app itself shipped. Regular expressions, matched without regard to case.
# PRTOP_DEPLOY_JOB_PATTERN=deploy.*prod|prod.*deploy
# PRTOP_PRIMARY_DEPLOY_JOB_PATTERN=^deploy[_-]production$

# In iTerm2, the live view colours the tab orange while an open merge request is
# on you, green otherwise.
# PRTOP_ITERM_TAB_COLOR=off

# Where prtop keeps what the last fetch saw. Defaults to
# ~/.local/state/prtop/<host>.json (%LOCALAPPDATA%\prtop\<host>.json on Windows).
# PRTOP_STATE_FILE=
