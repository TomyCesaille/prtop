---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'prtop -- htop for your merge requests',
  description = 'htop for your GitLab merge requests and GitHub pull requests: review to production, live in your terminal. Built to wake Claude Code.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/prtop/favicon.svg" />
    <link rel="apple-touch-icon" href="/prtop/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tomycesaille.github.io/prtop/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://tomycesaille.github.io/prtop/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The prtop logo, a pr prompt with a yellow block cursor, beside its name and tagline" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body>
    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>

<style>
  .page-wrapper {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-md);
  }
</style>
